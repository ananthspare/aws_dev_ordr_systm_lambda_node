# AWS Environment Variables Template for ECS Task Definition
# Copy this file and update the values according to your AWS environment

# Spring Profile
SPRING_PROFILES_ACTIVE=aws

# Database Configuration
DB_HOST=ecommerce-mysql-db.cwhegcq847i3.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=ecommerce
DB_USERNAME=admin
# DB_PASSWORD will be retrieved from AWS Secrets Manager

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MIN_IDLE=5
DB_IDLE_TIMEOUT=300000
DB_CONNECTION_TIMEOUT=20000
DB_LEAK_DETECTION=60000
DB_MAX_LIFETIME=1800000

# JPA Settings
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Server Configuration
SERVER_PORT=8080
CONTEXT_PATH=/api/v1

# AWS Configuration
AWS_REGION=us-east-1

# AWS Secrets Manager
AWS_SECRETS_ENABLED=true
DB_SECRET_NAME=ecommerce/db/credentials

# AWS S3 Configuration
S3_BUCKET_NAME=ecommerce-invoices-bucket
AWS_S3_REGION=us-east-1

# AWS DynamoDB Configuration
AWS_DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_PREFIX=ecommerce
DYNAMODB_ORDERS_TABLE=ecommerce-orders

# AWS SQS Configuration
AWS_SQS_REGION=us-east-1
SQS_ORDER_QUEUE=ecommerce-order-processing

# AWS EventBridge Configuration
AWS_EVENTBRIDGE_REGION=us-east-1
EVENTBRIDGE_BUS=ecommerce-events

# Security Configuration
JWT_SECRET=mySecretKey123456789012345678901234567890
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-frontend-domain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_SQL=WARN
LOG_LEVEL_SQL_PARAMS=WARN
LOG_LEVEL_AWS_SDK=WARN
LOG_LEVEL_AWS=WARN
LOG_FILE_PATH=/var/log/ecommerce-backend.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=30

# Management and Monitoring
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
MANAGEMENT_BASE_PATH=/actuator
HEALTH_SHOW_DETAILS=when-authorized
HEALTH_SHOW_COMPONENTS=when-authorized

# CloudWatch Metrics
CLOUDWATCH_METRICS_ENABLED=true
CLOUDWATCH_NAMESPACE=ECommerce/Backend
CLOUDWATCH_STEP=PT1M

# Application Configuration
CART_SESSION_TIMEOUT=1800000
CART_MAX_ITEMS=50
ORDER_PROCESSING_TIMEOUT=300000
INVOICE_GENERATION_ENABLED=true
PAYMENT_MOCK_ENABLED=true
PAYMENT_TIMEOUT=30000

# Email Configuration
EMAIL_ENABLED=false
EMAIL_FROM=noreply@ecommerce.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=100

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=10MB
UPLOAD_TEMP_DIR=/tmp/ecommerce-uploads

# Thread Pool Configuration
TASK_CORE_POOL_SIZE=5
TASK_MAX_POOL_SIZE=20
TASK_QUEUE_CAPACITY=100
TASK_KEEP_ALIVE=60s

# Cache Configuration (Redis)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2000

# Feature Flags
FEATURE_ASYNC_ORDERS=false
FEATURE_INVENTORY_TRACKING=true
FEATURE_RECOMMENDATIONS=false
FEATURE_ANALYTICS=true
FEATURE_AUDIT_LOGGING=true

# Application Version
APP_VERSION=1.0.0