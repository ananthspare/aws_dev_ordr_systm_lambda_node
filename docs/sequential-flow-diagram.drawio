        <!-- Detailed Flow Information Below -->
        <mxCell id="details-title" value="Detailed Sequential Flow Information" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="550" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Flow Details (same as before) -->
        <mxCell id="flow1-details" value="Flow 1: User Registration&#xa;1a: POST /auth/register → API Gateway receives registration request&#xa;1b: Route to ALB → API Gateway forwards to Application Load Balancer&#xa;1c: Forward to ECS → ALB routes to ECS Spring Boot Auth API&#xa;1d: INSERT customers → ECS validates data and creates customer record in RDS customers table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="600" height="80" as="geometry" />
        </mxCell>

        <mxCell id="flow5-details" value="Flow 5: Checkout/Place Order (Critical Path - 10 Steps)&#xa;5a: POST /checkout/place-order → Angular submits checkout request with countryCode&#xa;5b: JWT validation → Lambda Authorizer validates token and passes customerId context&#xa;5c: Route to PlaceOrder Lambda → API Gateway invokes Node.js PlaceOrder function&#xa;5d: Query DDB Cart → Lambda reads all cart items for customer, validates not empty&#xa;5e: INSERT orders/order_items → Create order record in RDS orders table with CREATED/PAID status&#xa;5f: PUT OrdersStatus (CREATED) → Initial status record in DynamoDB OrdersStatus table&#xa;5g: PUT invoice PDF → Generate and upload invoice to S3 invoices/{orderId}.pdf&#xa;5h: Send SQS message → Queue order for async processing {orderId, customerId, countryCode}&#xa;5i: Publish OrderCreated → EventBridge event for shipping workflow initiation&#xa;5j: Batch DELETE cart items → Clear customer cart from DynamoDB after successful order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="800" height="160" as="geometry" />
        </mxCell>

        <mxCell id="flow6-details" value="Flow 6: Async Processing&#xa;6a: SQS → ECS Worker polls messages from order processing queue&#xa;6b: UPDATE inventory → ECS Worker decrements product quantities in RDS inventory table&#xa;6c: UPDATE OrdersStatus (PROCESSED) → Update status in DynamoDB OrdersStatus table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="880" width="600" height="60" as="geometry" />
        </mxCell>

        <mxCell id="flow8-details" value="Flow 8: Order Tracking&#xa;8a: GET /orders/{id} → Angular requests order details&#xa;8b: Query orders → ECS reads order data from RDS orders table&#xa;8c: Query OrdersStatus → ECS reads current status from DynamoDB OrdersStatus table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="960" width="600" height="60" as="geometry" />
        </mxCell>

        <mxCell id="status-progression" value="Order Status Progression: CREATED → PROCESSED → SHIPPED → DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="1040" width="700" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
